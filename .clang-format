BasedOnStyle: LLVM
IndentWidth: 4
ColumnLimit: 120
# Allman everywhere except extern "C", whose body stays at file scope.
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: true
  AfterClass: true
  AfterControlStatement: Always
  AfterEnum: true
  AfterExternBlock: false
  AfterFunction: true
  AfterNamespace: true
  AfterObjCDeclaration: true
  AfterStruct: true
  AfterUnion: true
  BeforeCatch: true
  BeforeElse: true
  BeforeLambdaBody: true
  BeforeWhile: false
  IndentBraces: false
  SplitEmptyFunction: true
  SplitEmptyRecord: true
  SplitEmptyNamespace: true
IndentExternBlock: NoIndent
AllowShortFunctionsOnASingleLine: None
AllowShortBlocksOnASingleLine: Never
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortEnumsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
SeparateDefinitionBlocks: Always
MaxEmptyLinesToKeep: 1
IndentCaseLabels: true
PointerAlignment: Right
# Includes: project headers, then <graphite/...>, then system and platform headers.
# <windows.h> sorts first in its group because other Windows SDK headers depend on it.
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^"'
    Priority: 1
  - Regex: '^<graphite/'
    Priority: 2
  - Regex: '^<windows\.h>$'
    Priority: 3
    SortPriority: 3
  - Regex: '^<'
    Priority: 3
    SortPriority: 4
