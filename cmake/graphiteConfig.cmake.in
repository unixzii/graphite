@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(@GRAPHITE_PACKAGE_GTK@)
    find_dependency(PkgConfig)
    pkg_check_modules(GTK4 REQUIRED IMPORTED_TARGET gtk4>=4.22)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/graphiteTargets.cmake")
foreach(component IN LISTS graphite_FIND_COMPONENTS)
    if(TARGET graphite::${component})
        set(graphite_${component}_FOUND TRUE)
    else()
        set(graphite_${component}_FOUND FALSE)
    endif()
endforeach()
check_required_components(graphite)
